@page
@model MpdApply.Pages.Settings.IndexModel
@{ ViewData["Title"] = "Department Settings"; ViewData["IsAdmin"] = true; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Department Settings</h4>
    <a asp-page="/Admin/Forms/Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Admin
    </a>
</div>

@if (Model.Message != null)
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="row g-4">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header-mpd">General Settings</div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Agency Name <span class="text-danger">*</span></label>
                        <input asp-for="AgencyName" class="form-control" />
                        <span asp-validation-for="AgencyName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Default Recipient Email <span class="text-danger">*</span></label>
                        <input asp-for="RecipientEmail" class="form-control" type="email" />
                        <div class="form-text">Completed forms are emailed here unless overridden per-form.</div>
                        <span asp-validation-for="RecipientEmail" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Department Logo</label>
                        @if (!string.IsNullOrEmpty(Model.CurrentLogoBase64))
                        {
                            <div class="mb-2 d-flex align-items-center gap-3">
                                <img src="@Model.CurrentLogoBase64" style="max-height:60px;max-width:120px;object-fit:contain;border:1px solid #dee2e6;padding:4px;border-radius:4px" />
                                <form method="post" asp-page-handler="ClearLogo" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger">Remove Logo</button>
                                </form>
                            </div>
                        }
                        <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" />
                        <div class="form-text">PNG or SVG recommended. Appears in the form header and on generated PDFs.</div>
                    </div>
                    <button type="submit" class="btn btn-mpd">
                        <i class="bi bi-floppy me-1"></i>Save Settings
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header-mpd">Admin Password</div>
            <div class="card-body">
                <p class="text-muted small">The admin password is set via the <code>Admin__Password</code> environment variable in Railway. To change it, update that variable and redeploy.</p>
            </div>
        </div>
        <div class="card shadow-sm mt-3">
            <div class="card-header-mpd">Claude AI Integration</div>
            <div class="card-body">
                <p class="text-muted small">To enable AI-powered PDF-to-form conversion, set the <code>Claude__ApiKey</code> environment variable in Railway with your Anthropic API key.</p>
                <p class="text-muted small mb-0">Get your API key at <strong>console.anthropic.com</strong>.</p>
            </div>
        </div>
    </div>
</div>
