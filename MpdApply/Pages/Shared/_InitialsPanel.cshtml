@* Initials panel — set initials once, click each field individually to stamp *@
<div class="initials-panel card shadow-sm mb-4" style="position:sticky;top:0;z-index:100;border-left:4px solid #285190">
    <div class="card-body py-2 px-3">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="fw-bold text-nowrap" style="color:#285190">
                <i class="bi bi-pen me-1"></i>Your Initials:
            </span>

            <ul class="nav nav-pills mb-0">
                <li class="nav-item">
                    <a class="nav-link active py-1 px-2 small" id="typeTabBtn" href="#">
                        <i class="bi bi-fonts me-1"></i>Type
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link py-1 px-2 small" id="drawTabBtn" href="#">
                        <i class="bi bi-pencil me-1"></i>Draw
                    </a>
                </li>
            </ul>

            <div id="typeModePanel" class="d-flex gap-2 align-items-center">
                <input id="initialsText" class="form-control form-control-sm" style="width:70px;font-size:1.1rem" maxlength="5" placeholder="JL" />
                <select id="initialsFont" class="form-select form-select-sm" style="width:175px">
                    <option value="'Brush Script MT', cursive">Brush Script (cursive)</option>
                    <option value="cursive">System Cursive</option>
                    <option value="Georgia, serif">Georgia (serif)</option>
                    <option value="Arial, sans-serif">Arial (print)</option>
                </select>
            </div>

            <div id="drawModePanel" style="display:none" class="d-flex align-items-center gap-2">
                <div style="border:1px solid #ced4da;border-radius:4px;background:#fff;display:inline-block">
                    <canvas id="initDrawCanvas" width="180" height="54" style="display:block;cursor:crosshair"></canvas>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="clearInitBtn">Clear</button>
            </div>

            <span class="text-muted small ms-1">
                <i class="bi bi-hand-index me-1"></i>Click each field below to initial it
            </span>
        </div>
    </div>
</div>

<input type="hidden" name="InitialsMode" id="initialsMode" />
<input type="hidden" name="InitialsImageData" id="initialsImageData" />

<script>
(function () {
    // ── Signature pad for draw mode ──
    const canvas = document.getElementById('initDrawCanvas');
    const pad = new SignaturePad(canvas, { backgroundColor: 'rgb(255,255,255)', minWidth: 1.5, maxWidth: 3 });
    document.getElementById('clearInitBtn').addEventListener('click', () => pad.clear());

    // ── Tab switching ──
    const typeBtn = document.getElementById('typeTabBtn');
    const drawBtn = document.getElementById('drawTabBtn');
    const typePanel = document.getElementById('typeModePanel');
    const drawPanel = document.getElementById('drawModePanel');

    typeBtn.addEventListener('click', e => { e.preventDefault(); activateTab('type'); });
    drawBtn.addEventListener('click', e => { e.preventDefault(); activateTab('draw'); });

    function activateTab(mode) {
        if (mode === 'type') {
            typePanel.style.display = '';
            drawPanel.style.display = 'none';
            typeBtn.classList.add('active');
            drawBtn.classList.remove('active');
        } else {
            typePanel.style.display = 'none';
            drawPanel.style.display = 'flex';
            drawBtn.classList.add('active');
            typeBtn.classList.remove('active');
        }
    }

    // ── Click each field to stamp initials ──
    function stampField(field) {
        const isDrawMode = drawBtn.classList.contains('active');

        if (isDrawMode) {
            if (pad.isEmpty()) { alert('Please draw your initials in the box above first.'); return; }
            const dataUrl = pad.toDataURL('image/png');
            document.getElementById('initialsImageData').value = dataUrl;
            document.getElementById('initialsMode').value = 'drawn';
            field.value = '(initialed)';
            field.style.backgroundImage = `url('${dataUrl}')`;
            field.style.backgroundSize = 'contain';
            field.style.backgroundRepeat = 'no-repeat';
            field.style.backgroundPosition = 'center';
            field.style.color = 'transparent';
            localStorage.setItem('mpd_initials', JSON.stringify({ mode: 'drawn', image: dataUrl }));
        } else {
            const text = document.getElementById('initialsText').value.trim();
            const font = document.getElementById('initialsFont').value;
            if (!text) { alert('Please type your initials in the box above first.'); return; }
            document.getElementById('initialsMode').value = 'text';
            document.getElementById('initialsImageData').value = '';
            field.value = text;
            field.style.fontFamily = font;
            field.style.fontSize = '1.1rem';
            field.style.backgroundImage = '';
            field.style.color = '';
            localStorage.setItem('mpd_initials', JSON.stringify({ mode: 'text', text, font }));
        }

        field.style.borderColor = '#198754';
        field.style.backgroundColor = '#f0fff4';
    }

    // Wire up all initials fields on this page
    document.querySelectorAll('.initial-field').forEach(field => {
        field.readOnly = true;
        field.style.cursor = 'pointer';
        field.title = 'Click to initial';
        field.placeholder = 'Click';
        field.addEventListener('click', () => stampField(field));
    });

    // ── Restore from localStorage ──
    try {
        const saved = localStorage.getItem('mpd_initials');
        if (saved) {
            const data = JSON.parse(saved);
            if (data.mode === 'text' && data.text) {
                document.getElementById('initialsText').value = data.text;
                if (data.font) document.getElementById('initialsFont').value = data.font;
            } else if (data.mode === 'drawn' && data.image) {
                activateTab('draw');
            }
        }
    } catch (e) {}
})();
</script>
