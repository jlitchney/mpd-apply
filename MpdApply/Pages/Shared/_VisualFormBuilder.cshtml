@model (string Json, string InputName, string PdfPreviewUrl)
@{ var inputId = Model.InputName.Replace(".", "_"); }

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.3/Sortable.min.js"></script>

<ul class="nav nav-tabs mb-0" id="fb-tabs">
    <li class="nav-item">
        <button type="button" class="nav-link active" id="fb-tab-visual" onclick="fbSwitchTab('visual')">
            <i class="bi bi-grid-1x2-fill me-1"></i>Visual Editor
        </button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link" id="fb-tab-pdf" onclick="fbSwitchTab('pdf')">
            <i class="bi bi-file-earmark-pdf me-1"></i>PDF Style
        </button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link" id="fb-tab-json" onclick="fbSwitchTab('json')">
            <i class="bi bi-code-slash me-1"></i>JSON
        </button>
    </li>
    <li class="nav-item ms-auto d-flex align-items-center pe-1">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fbOpenPreview()" style="font-size:.8rem">
            <i class="bi bi-eye me-1"></i>Preview
        </button>
    </li>
</ul>

<div id="fb-pane-visual" class="border border-top-0 rounded-bottom p-3" style="background:#f8f9fa">
    <div id="fb-pages"></div>
    <button type="button" class="btn btn-sm btn-outline-primary mt-1" onclick="fbAddPage()">
        <i class="bi bi-plus me-1"></i>Add Page
    </button>
</div>

<div id="fb-pane-json" class="border border-top-0 rounded-bottom" style="display:none">
    <textarea name="@Model.InputName" id="@inputId"
              class="form-control font-monospace border-0 rounded-bottom"
              rows="22" style="font-size:.78rem">@Model.Json</textarea>
</div>

<div id="fb-pane-pdf" class="border border-top-0 rounded-bottom p-3" style="display:none">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label fw-semibold small">Accent Color</label>
            <input type="color" id="fb-pdf-color" class="form-control form-control-color w-100"
                   value="#285190" onchange="fbUpdatePdfStyle()" />
            <div class="form-text" style="font-size:.71rem">Section headers &amp; dividers</div>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold small">Field Style</label>
            <select id="fb-pdf-fieldstyle" class="form-select form-select-sm" onchange="fbUpdatePdfStyle()">
                <option value="underline">Underline (classic form)</option>
                <option value="box">Box (bordered cells)</option>
                <option value="shaded">Shaded label (official look)</option>
            </select>
            <div class="form-text" style="font-size:.71rem">How field values appear in the PDF</div>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold small">Font Size</label>
            <select id="fb-pdf-fontsize" class="form-select form-select-sm" onchange="fbUpdatePdfStyle()">
                <option value="8">Small (8pt)</option>
                <option value="9">Normal (9pt)</option>
                <option value="10">Large (10pt)</option>
            </select>
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <input type="checkbox" id="fb-pdf-compact" class="form-check-input" onchange="fbUpdatePdfStyle()" />
                <label class="form-check-label small" for="fb-pdf-compact">Compact spacing</label>
                <div class="form-text" style="font-size:.71rem">Tighter gaps between fields</div>
            </div>
            <div class="form-check mt-2">
                <input type="checkbox" id="fb-pdf-showmeta" class="form-check-input" onchange="fbUpdatePdfStyle()" checked />
                <label class="form-check-label small" for="fb-pdf-showmeta">Show submission info</label>
                <div class="form-text" style="font-size:.71rem">Date &amp; IP at bottom of PDF</div>
            </div>
        </div>
    </div>
    <div class="mt-3 p-2 rounded" style="background:#e8f0fe;border:1px solid #c6d4f3;font-size:.78rem;color:#285190">
        <i class="bi bi-info-circle me-1"></i>
        These settings control how the PDF looks when a submission is downloaded. They do not affect how the form appears to applicants.
    </div>
</div>

<!-- Field edit modal -->
<div class="modal fade" id="fbFieldModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title mb-0" id="fbModalTitle">Field</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-5" id="fm-row-type">
                        <label class="form-label fw-semibold small">Type</label>
                        <select id="fm-type" class="form-select form-select-sm" onchange="fbUpdateModal()">
                            <optgroup label="Input Fields">
                                <option value="text">Text</option>
                                <option value="email">Email</option>
                                <option value="tel">Phone</option>
                                <option value="date">Date</option>
                                <option value="number">Number</option>
                                <option value="textarea">Textarea (multi-line)</option>
                            </optgroup>
                            <optgroup label="Choice Fields">
                                <option value="select">Dropdown (Select)</option>
                                <option value="radio">Radio Buttons</option>
                                <option value="yesno">Yes / No</option>
                                <option value="checkbox">Checkbox</option>
                            </optgroup>
                            <optgroup label="Signatures &amp; Initials">
                                <option value="signature">Signature Pad</option>
                                <option value="initials">Initials Field</option>
                                <option value="initials_panel">Initials Setup Panel</option>
                                <option value="initials_reminder">Initials Reminder</option>
                            </optgroup>
                            <optgroup label="Layout">
                                <option value="section_header">Section Header</option>
                                <option value="paragraph">Paragraph / Text Block</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="col-md-4" id="fm-row-key">
                        <label class="form-label fw-semibold small">Key <span class="text-danger">*</span></label>
                        <input id="fm-key" class="form-control form-control-sm" placeholder="field_key" />
                        <div class="form-text" style="font-size:.7rem">Unique, snake_case</div>
                    </div>
                    <div class="col-md-3" id="fm-row-width">
                        <label class="form-label fw-semibold small">Width</label>
                        <select id="fm-width" class="form-select form-select-sm">
                            <option value="full">Full width</option>
                            <option value="half">Half (50%)</option>
                            <option value="third">Third (33%)</option>
                            <option value="quarter">Quarter (25%)</option>
                        </select>
                    </div>
                    <div class="col-12" id="fm-row-label">
                        <label class="form-label fw-semibold small">Label</label>
                        <input id="fm-label" class="form-control form-control-sm" placeholder="Label shown to applicant" oninput="fbAutoKey()" />
                    </div>
                    <div class="col-12" id="fm-row-content">
                        <label class="form-label fw-semibold small">Content</label>
                        <textarea id="fm-content" class="form-control form-control-sm" rows="5" placeholder="Paragraph text..."></textarea>
                    </div>
                    <div class="col-12" id="fm-row-linkhelp" style="margin-top:-4px;display:none">
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fbInsertLink()">
                            <i class="bi bi-link-45deg me-1"></i>Insert Link
                        </button>
                        <span class="text-muted ms-2" style="font-size:.72rem">Inserts <code>[link text](https://...)</code> — renders as a clickable link</span>
                    </div>
                    <div class="col-12" id="fm-row-options">
                        <label class="form-label fw-semibold small">Options <span class="fw-normal text-muted">(one per line)</span></label>
                        <textarea id="fm-options" class="form-control form-control-sm font-monospace" rows="5" placeholder="Option 1&#10;Option 2&#10;Option 3"></textarea>
                    </div>
                    <div class="col-md-6" id="fm-row-placeholder">
                        <label class="form-label small">Placeholder</label>
                        <input id="fm-placeholder" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6" id="fm-row-helptext">
                        <label class="form-label small">Help Text</label>
                        <input id="fm-helptext" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2" id="fm-row-rows">
                        <label class="form-label small">Rows</label>
                        <input type="number" id="fm-rows" class="form-control form-control-sm" value="3" min="2" max="20" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end" id="fm-row-required">
                        <div class="form-check mb-1">
                            <input type="checkbox" id="fm-required" class="form-check-input" />
                            <label class="form-check-label small fw-semibold" for="fm-required">Required field</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-success" onclick="fbSaveField()">
                    <i class="bi bi-check-lg me-1"></i>Save Field
                </button>
            </div>
        </div>
    </div>
</div>

<!-- PDF Style Preview Modal -->
<div class="modal fade" id="fbPdfPreviewModal" tabindex="-1">
    <div class="modal-dialog" style="max-width:min(880px,96vw);margin:1rem auto">
        <div class="modal-content" style="height:90vh">
            <div class="modal-header py-2" style="flex-shrink:0">
                <h6 class="modal-title mb-0">
                    <i class="bi bi-file-earmark-pdf me-1 text-danger"></i>PDF Style Preview
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="flex:1;min-height:0;position:relative;overflow:hidden">
                <div id="fb-pdf-loading" style="position:absolute;inset:0;background:#f8f9fa;z-index:2;display:flex;align-items:center;justify-content:center"></div>
                <iframe id="fb-pdf-frame" src="about:blank" style="width:100%;height:100%;border:none;display:block"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Form Preview Modal -->
<div class="modal fade" id="fbPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#285190;color:#fff;padding:.6rem 1rem">
                <div class="d-flex align-items-center gap-3 flex-grow-1">
                    <h6 class="modal-title mb-0"><i class="bi bi-eye me-1"></i>Form Preview</h6>
                    <div id="fb-prev-steps" class="d-flex gap-1 flex-wrap"></div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="fb-prev-body" style="background:#fafbfc"></div>
            <div class="modal-footer py-2" id="fb-prev-footer"></div>
        </div>
    </div>
</div>

<style>
/* ── Page cards ─────────────────────────────────────────────── */
.fb-page-card { background:#fff; border:1px solid #dee2e6; border-radius:8px; margin-bottom:12px; }
.fb-page-hdr  { background:#285190; color:#fff; padding:8px 12px; border-radius:7px 7px 0 0; display:flex; align-items:center; gap:8px; }
.fb-page-body { padding:12px; }
.fb-page-drag  { cursor:grab; opacity:.55; font-size:1.1rem; line-height:1; }
.fb-page-drag:hover { opacity:1; }
.fb-page-drag:active { cursor:grabbing; }
.fb-ph-btn { border:none; background:none; color:rgba(255,255,255,.65); padding:3px 6px; border-radius:4px; cursor:pointer; font-size:.78rem; }
.fb-ph-btn:hover { background:rgba(255,255,255,.18); color:#fff; }
.fb-ph-btn.del:hover { background:rgba(220,53,69,.55); color:#fff; }

/* ── Field canvas (flex grid) ───────────────────────────────── */
.fb-canvas { display:flex; flex-wrap:wrap; gap:8px; min-height:56px; border-radius:6px; padding:4px 2px; align-items:flex-start; }

/* Width slots — mirror actual form widths */
.fb-w-full    { width:100%; }
.fb-w-half    { width:calc(50% - 4px); min-width:180px; }
.fb-w-third   { width:calc(33.333% - 6px); min-width:150px; }
.fb-w-quarter { width:calc(25% - 6px); min-width:130px; }

/* ── Normal field card ──────────────────────────────────────── */
.fb-field-card {
  height:100%; background:#fff;
  border:1.5px solid #dee2e6; border-radius:6px;
  display:flex; align-items:flex-start; gap:6px;
  padding:8px 6px 8px 6px;
  transition:border-color .13s, box-shadow .13s;
}
.fb-field-card:hover { border-color:#285190; box-shadow:0 0 0 3px rgba(40,81,144,.09); }

/* ── Drag handle (shared) ───────────────────────────────────── */
.fb-handle {
  cursor:grab; color:#c8cfd8; font-size:1rem; flex-shrink:0;
  margin-top:2px; padding:0 1px; line-height:1; user-select:none;
}
.fb-handle:hover { color:#6c757d; }
.fb-handle:active { cursor:grabbing; }

/* ── Action buttons (shown on hover) ───────────────────────── */
.fb-acts { display:flex; gap:2px; flex-shrink:0; visibility:hidden; margin-left:auto; align-self:flex-start; margin-top:-1px; }
.fb-field-card:hover .fb-acts,
.fb-sec-row:hover .fb-acts,
.fb-para-row:hover .fb-acts,
.fb-info-row:hover .fb-acts { visibility:visible; }
.fb-act { border:none; background:none; padding:2px 5px; border-radius:3px; cursor:pointer; color:#6c757d; font-size:.75rem; }
.fb-act:hover { background:#e9ecef; color:#212529; }
.fb-act.del:hover { background:#f8d7da; color:#842029; }

/* ── Field preview content ──────────────────────────────────── */
.fb-preview { flex-grow:1; min-width:0; }
.fb-preview .form-label { font-size:.78rem; font-weight:600; margin-bottom:3px; }
.fb-preview .form-control,
.fb-preview .form-select { font-size:.75rem; pointer-events:none; }
.fb-preview textarea { resize:none; }
.fb-preview .form-check-label { font-size:.75rem; }

/* ── Section header row ─────────────────────────────────────── */
.fb-sec-row {
  width:100%; display:flex; align-items:center; gap:8px;
  border-bottom:2px solid #285190; padding:5px 4px 6px;
  color:#285190; font-weight:600; font-size:.88rem;
}
.fb-sec-row .fb-acts { margin-top:0; }

/* ── Paragraph row ──────────────────────────────────────────── */
.fb-para-row {
  width:100%; display:flex; align-items:flex-start; gap:8px;
  background:#f1f3f5; border-radius:5px; padding:7px 8px;
}
.fb-para-row .fb-acts { margin-top:0; }
.fb-para-text { flex-grow:1; font-size:.78rem; color:#6c757d; font-style:italic; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; }

/* ── Info banner (initials panel / reminder) ────────────────── */
.fb-info-row {
  width:100%; display:flex; align-items:center; gap:8px;
  background:#e8f0fe; border:1px solid #c6d4f3;
  border-radius:5px; padding:7px 10px;
  color:#285190; font-size:.82rem;
}

/* ── Signature preview ──────────────────────────────────────── */
.fb-sig-box {
  border:1.5px dashed #ced4da; border-radius:4px; height:44px;
  display:flex; align-items:center; justify-content:center;
  background:#fafafa; color:#adb5bd; font-size:.78rem;
}

/* ── Initials preview ───────────────────────────────────────── */
.fb-init-box {
  border:1.5px solid #ced4da; border-radius:4px;
  width:52px; height:28px; background:#f8f9fa; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  color:#adb5bd; font-size:.68rem;
}

/* ── Add field button ───────────────────────────────────────── */
.fb-add-btn {
  width:100%; border:2px dashed #ced4da; border-radius:6px;
  padding:8px; color:#6c757d; font-size:.82rem; background:none;
  cursor:pointer; text-align:center; margin-top:6px;
  transition:border-color .12s, color .12s, background .12s;
}
.fb-add-btn:hover { border-color:#285190; color:#285190; background:rgba(40,81,144,.04); }

/* ── SortableJS ─────────────────────────────────────────────── */
.fb-ghost { opacity:.2 !important; background:rgba(40,81,144,.07) !important; border:2px dashed #285190 !important; border-radius:6px; }
</style>

<script>
(function () {
    const TA_ID = '@inputId';
    const PDF_PREVIEW_URL = '@Model.PdfPreviewUrl';
    let schema = { pages: [] };
    let editPage = -1, editField = -1, autoKeyLocked = false;
    const sortables = {};

    const TYPE_PROPS = {
        text:              ['key','label','width','required','placeholder','helptext'],
        email:             ['key','label','width','required','placeholder','helptext'],
        tel:               ['key','label','width','required','placeholder','helptext'],
        date:              ['key','label','width','required','helptext'],
        number:            ['key','label','width','required','placeholder','helptext'],
        textarea:          ['key','label','width','required','placeholder','helptext','rows'],
        select:            ['key','label','width','required','options'],
        radio:             ['key','label','width','required','options'],
        yesno:             ['key','label','width','required','helptext'],
        checkbox:          ['key','label','width'],
        signature:         ['key','label','width','required'],
        initials:          ['key','label','required'],
        initials_panel:    [],
        initials_reminder: [],
        section_header:    ['key','label'],
        paragraph:         ['key','content'],
    };

    // ── Init ──────────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        loadFromTA();
        renderVisual();
        const ta = document.getElementById(TA_ID);
        if (ta) {
            const form = ta.closest('form');
            if (form) form.addEventListener('submit', () => {
                if (document.getElementById('fb-pane-visual').style.display !== 'none') saveToTA();
            });
        }
        document.getElementById('fm-key').addEventListener('input', function () { autoKeyLocked = !!this.value; });
    });

    function loadFromTA() {
        const ta = document.getElementById(TA_ID);
        const val = ta ? ta.value.trim() : '';
        try {
            const p = val ? JSON.parse(val) : null;
            schema = (p && Array.isArray(p.pages)) ? p : { pages: [] };
            if (!schema.pages.length) schema.pages.push({ title: 'Page 1', fields: [] });
        } catch (e) {
            schema = { pages: [{ title: 'Page 1', fields: [] }] };
        }
    }

    function saveToTA() {
        const ta = document.getElementById(TA_ID);
        if (ta) ta.value = JSON.stringify(schema, null, 2);
    }

    // ── Tab ───────────────────────────────────────────────────────────────
    window.fbSwitchTab = function (tab) {
        const wasJson = document.getElementById('fb-pane-json').style.display !== 'none';

        if (wasJson) {
            // Parse JSON back into schema before leaving JSON tab
            const ta = document.getElementById(TA_ID);
            try {
                const p = JSON.parse(ta.value.trim());
                if (p && Array.isArray(p.pages)) schema = p;
                else if (ta.value.trim()) { alert('Invalid JSON — fix before switching.'); return; }
            } catch (e) { alert('Invalid JSON:\n' + e.message); return; }
        } else {
            saveToTA();
        }

        document.getElementById('fb-pane-visual').style.display = tab === 'visual' ? '' : 'none';
        document.getElementById('fb-pane-pdf').style.display    = tab === 'pdf'    ? '' : 'none';
        document.getElementById('fb-pane-json').style.display   = tab === 'json'   ? '' : 'none';
        ['visual','pdf','json'].forEach(t => {
            document.getElementById(`fb-tab-${t}`).classList.toggle('active', t === tab);
        });

        if (tab === 'visual') renderVisual();
        if (tab === 'pdf')    loadPdfStyleUI();
        if (tab === 'json')   saveToTA();
    };

    // ── Render ─────────────────────────────────────────────────────────────
    function renderVisual() {
        const container = document.getElementById('fb-pages');
        container.innerHTML = '';
        schema.pages.forEach((page, pi) => container.appendChild(buildPageEl(page, pi)));
        initSortables();
    }

    function buildPageEl(page, pi) {
        const div = document.createElement('div');
        div.className = 'fb-page-card';
        div.dataset.pageIdx = pi;
        div.innerHTML =
            `<div class="fb-page-hdr">` +
            `<span class="fb-page-drag" title="Drag to reorder page">⠿</span>` +
            `<span style="font-weight:600;font-size:.9rem;flex-grow:1">Page ${pi + 1}</span>` +
            `<button type="button" class="fb-ph-btn del" onclick="fbDeletePage(${pi})" title="Delete page"><i class="bi bi-trash"></i></button>` +
            `</div>` +
            `<div class="fb-page-body">` +
            `<div class="row g-2 mb-3">` +
            `<div class="col-md-4"><label class="form-label small fw-semibold mb-1">Page Title</label>` +
            `<input type="text" class="form-control form-control-sm" value="${esc(page.title || '')}" onchange="fbUpdatePage(${pi},'title',this.value)"/></div>` +
            `<div class="col-md-8"><label class="form-label small fw-semibold mb-1">Intro Text <span class="fw-normal text-muted">(optional)</span></label>` +
            `<input type="text" class="form-control form-control-sm" value="${esc(page.intro || '')}" onchange="fbUpdatePage(${pi},'intro',this.value)"/></div>` +
            `</div>` +
            `<div class="fb-canvas" data-pi="${pi}">${buildFieldsHtml(page.fields || [], pi)}</div>` +
            `<button type="button" class="fb-add-btn" onclick="fbAddField(${pi})"><i class="bi bi-plus-circle me-1"></i>Add Field</button>` +
            `</div>`;
        return div;
    }

    function buildFieldsHtml(fields, pi) {
        return fields.map((f, fi) => buildSlotHtml(f, pi, fi)).join('');
    }

    function buildSlotHtml(f, pi, fi) {
        const editBtn = (f.type !== 'initials_panel' && f.type !== 'initials_reminder')
            ? `<button type="button" class="fb-act" onclick="fbOpenFieldModal(${pi},${fi})" title="Edit"><i class="bi bi-pencil-fill"></i></button>`
            : '';
        const delBtn = `<button type="button" class="fb-act del" onclick="fbDeleteField(${pi},${fi})" title="Delete"><i class="bi bi-trash"></i></button>`;
        const acts = `<div class="fb-acts">${editBtn}${delBtn}</div>`;

        if (f.type === 'section_header') {
            return `<div class="fb-w-full fb-sec-row" data-fi="${fi}">` +
                `<span class="fb-handle" title="Drag to reorder">⠿</span>` +
                `<span style="flex-grow:1">${escH(f.label || '(Section Header)')}</span>` +
                acts + `</div>`;
        }
        if (f.type === 'paragraph') {
            const txt = (f.content || '(empty paragraph)').substring(0, 160);
            return `<div class="fb-w-full fb-para-row" data-fi="${fi}">` +
                `<span class="fb-handle" title="Drag to reorder">⠿</span>` +
                `<i class="bi bi-text-paragraph text-muted flex-shrink-0" style="margin-top:2px"></i>` +
                `<span class="fb-para-text">${escH(txt)}${(f.content || '').length > 160 ? '…' : ''}</span>` +
                acts + `</div>`;
        }
        if (f.type === 'initials_panel' || f.type === 'initials_reminder') {
            const icon = f.type === 'initials_panel' ? 'bi-keyboard' : 'bi-bell-fill';
            const label = f.type === 'initials_panel' ? 'Initials Setup Panel' : 'Initials Reminder';
            return `<div class="fb-w-full fb-info-row" data-fi="${fi}">` +
                `<span class="fb-handle" title="Drag to reorder">⠿</span>` +
                `<i class="bi ${icon}"></i><span style="flex-grow:1">${label}</span>` +
                acts + `</div>`;
        }

        const wc = ({ half: 'fb-w-half', third: 'fb-w-third', quarter: 'fb-w-quarter' })[f.width] || 'fb-w-full';
        return `<div class="${wc}" data-fi="${fi}">` +
            `<div class="fb-field-card">` +
            `<span class="fb-handle" title="Drag to reorder">⠿</span>` +
            `<div class="fb-preview">${buildPreview(f)}</div>` +
            acts +
            `</div></div>`;
    }

    function buildPreview(f) {
        const lbl  = escH(f.label || f.key || '');
        const req  = f.required ? '<span class="text-danger ms-1">*</span>' : '';
        const labelHtml = `<div class="form-label">${lbl}${req}</div>`;

        switch (f.type) {
            case 'textarea':
                return labelHtml +
                    `<textarea class="form-control form-control-sm" rows="${Math.min(f.rows || 3, 3)}" disabled ` +
                    `placeholder="${escA(f.placeholder || '')}" style="resize:none"></textarea>`;

            case 'select': {
                const opts = (f.options || []).slice(0, 5).map(o => `<option>${escH(o)}</option>`).join('');
                const more = f.options && f.options.length > 5
                    ? `<option disabled>+ ${f.options.length - 5} more…</option>` : '';
                return labelHtml +
                    `<select class="form-select form-select-sm" disabled><option>-- Select --</option>${opts}${more}</select>`;
            }

            case 'radio': {
                const opts = (f.options || []).slice(0, 4);
                const more = f.options && f.options.length > 4
                    ? `<span class="text-muted ms-1" style="font-size:.7rem">+${f.options.length - 4} more</span>` : '';
                const radios = opts.map(o =>
                    `<div class="form-check form-check-inline mb-0">` +
                    `<input type="radio" class="form-check-input" disabled>` +
                    `<label class="form-check-label">${escH(o)}</label></div>`
                ).join('');
                return labelHtml + `<div>${radios}${more}</div>`;
            }

            case 'yesno':
                return labelHtml +
                    `<div class="d-flex gap-3">` +
                    `<div class="form-check"><input type="radio" class="form-check-input" disabled><label class="form-check-label">Yes</label></div>` +
                    `<div class="form-check"><input type="radio" class="form-check-input" disabled><label class="form-check-label">No</label></div>` +
                    `</div>`;

            case 'checkbox':
                return `<div class="form-check mt-1">` +
                    `<input type="checkbox" class="form-check-input" disabled>` +
                    `<label class="form-check-label">${lbl}${req}</label></div>`;

            case 'signature':
                return labelHtml +
                    `<div class="fb-sig-box"><i class="bi bi-pen me-1"></i>Signature area</div>`;

            case 'initials':
                return `<div class="d-flex align-items-center gap-2">` +
                    `<div class="fb-init-box">init</div>` +
                    `<span class="form-label mb-0" style="font-size:.78rem">${lbl}${req}</span></div>`;

            default: { // text, email, tel, date, number
                const t = ['text', 'email', 'tel', 'date', 'number'].includes(f.type) ? f.type : 'text';
                return labelHtml +
                    `<input type="${t}" class="form-control form-control-sm" disabled placeholder="${escA(f.placeholder || '')}">`;
            }
        }
    }

    // ── SortableJS ─────────────────────────────────────────────────────────
    function initSortables() {
        // Pages drag-and-drop
        if (sortables._pages) { try { sortables._pages.destroy(); } catch (e) {} }
        sortables._pages = Sortable.create(document.getElementById('fb-pages'), {
            handle: '.fb-page-drag',
            animation: 150,
            ghostClass: 'fb-ghost',
            onEnd(evt) {
                if (evt.oldIndex === evt.newIndex) return;
                const cards = document.querySelectorAll('.fb-page-card');
                const old = [...schema.pages];
                schema.pages = Array.from(cards).map(el => old[parseInt(el.dataset.pageIdx)]);
                renderVisual();
                saveToTA();
            }
        });
        // Fields drag-and-drop (one per page)
        schema.pages.forEach((_, pi) => initFieldSortable(pi));
    }

    function initFieldSortable(pi) {
        const el = document.querySelector(`.fb-canvas[data-pi="${pi}"]`);
        if (!el) return;
        if (sortables[pi]) { try { sortables[pi].destroy(); } catch (e) {} }
        sortables[pi] = Sortable.create(el, {
            handle: '.fb-handle',
            draggable: '[data-fi]',
            animation: 150,
            ghostClass: 'fb-ghost',
            onEnd(evt) {
                const oi = evt.oldDraggableIndex, ni = evt.newDraggableIndex;
                if (oi == null || ni == null || oi === ni) return;
                const fields = schema.pages[pi].fields;
                const [moved] = fields.splice(oi, 1);
                fields.splice(ni, 0, moved);
                refreshCanvas(pi);
                saveToTA();
            }
        });
    }

    function refreshCanvas(pi) {
        const el = document.querySelector(`.fb-canvas[data-pi="${pi}"]`);
        if (!el) return;
        el.innerHTML = buildFieldsHtml(schema.pages[pi].fields, pi);
        initFieldSortable(pi);
    }

    // ── Page actions ───────────────────────────────────────────────────────
    window.fbAddPage = function () {
        schema.pages.push({ title: `Page ${schema.pages.length + 1}`, fields: [] });
        renderVisual(); saveToTA();
    };
    window.fbDeletePage = function (pi) {
        if (schema.pages.length <= 1) { alert('A form must have at least one page.'); return; }
        if (!confirm(`Delete Page ${pi + 1} and all its fields?`)) return;
        schema.pages.splice(pi, 1);
        renderVisual(); saveToTA();
    };
    window.fbUpdatePage = function (pi, prop, val) { schema.pages[pi][prop] = val; saveToTA(); };

    // ── Field actions ──────────────────────────────────────────────────────
    window.fbAddField = function (pi) {
        editPage = pi; editField = -1; autoKeyLocked = false;
        resetModal();
        document.getElementById('fbModalTitle').textContent = 'Add Field';
        new bootstrap.Modal(document.getElementById('fbFieldModal')).show();
    };
    window.fbOpenFieldModal = function (pi, fi) {
        editPage = pi; editField = fi; autoKeyLocked = true;
        populateModal(schema.pages[pi].fields[fi]);
        document.getElementById('fbModalTitle').textContent = 'Edit Field';
        new bootstrap.Modal(document.getElementById('fbFieldModal')).show();
    };
    window.fbDeleteField = function (pi, fi) {
        schema.pages[pi].fields.splice(fi, 1);
        refreshCanvas(pi); saveToTA();
    };
    window.fbSaveField = function () {
        const type  = document.getElementById('fm-type').value;
        const props = TYPE_PROPS[type] || [];
        const field = { type };

        if (props.includes('key')) {
            const key = document.getElementById('fm-key').value.trim();
            if (!key) { alert('Field Key is required.'); return; }
            field.key = key;
        } else {
            field.key = type + '_' + Math.random().toString(36).slice(2, 7);
        }
        if (props.includes('label'))   { const v = document.getElementById('fm-label').value.trim(); if (v) field.label = v; }
        if (props.includes('content')) { field.content = document.getElementById('fm-content').value; }
        if (props.includes('width'))   { field.width = document.getElementById('fm-width').value; }
        if (props.includes('required') && document.getElementById('fm-required').checked) field.required = true;
        if (props.includes('placeholder')) { const v = document.getElementById('fm-placeholder').value.trim(); if (v) field.placeholder = v; }
        if (props.includes('helptext'))    { const v = document.getElementById('fm-helptext').value.trim(); if (v) field.helpText = v; }
        if (props.includes('rows'))    { field.rows = parseInt(document.getElementById('fm-rows').value) || 3; }
        if (props.includes('options')) { field.options = document.getElementById('fm-options').value.split('\n').map(s => s.trim()).filter(Boolean); }

        Object.keys(field).forEach(k => field[k] === undefined && delete field[k]);

        if (editField >= 0) schema.pages[editPage].fields[editField] = field;
        else schema.pages[editPage].fields.push(field);

        refreshCanvas(editPage); saveToTA();
        bootstrap.Modal.getInstance(document.getElementById('fbFieldModal')).hide();
    };

    // ── Modal helpers ──────────────────────────────────────────────────────
    window.fbUpdateModal = function () {
        const type  = document.getElementById('fm-type').value;
        const props = TYPE_PROPS[type] || [];
        ['key','label','content','width','required','placeholder','helptext','rows','options'].forEach(r => {
            const el = document.getElementById(`fm-row-${r}`);
            if (el) el.style.display = props.includes(r) ? '' : 'none';
        });
        const lh = document.getElementById('fm-row-linkhelp');
        if (lh) lh.style.display = type === 'paragraph' ? '' : 'none';
    };
    window.fbAutoKey = function () {
        if (autoKeyLocked) return;
        const type  = document.getElementById('fm-type').value;
        const props = TYPE_PROPS[type] || [];
        if (!props.includes('key')) return;
        const prefix = type === 'section_header' ? 'sec_' : '';
        document.getElementById('fm-key').value = prefix +
            document.getElementById('fm-label').value
                .toLowerCase().replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '_').substring(0, 40);
    };

    function resetModal() {
        document.getElementById('fm-type').value = 'text';
        ['fm-key','fm-label','fm-content','fm-placeholder','fm-helptext','fm-options'].forEach(id => { document.getElementById(id).value = ''; });
        document.getElementById('fm-width').value = 'full';
        document.getElementById('fm-required').checked = false;
        document.getElementById('fm-rows').value = '3';
        fbUpdateModal();
    }
    function populateModal(f) {
        document.getElementById('fm-type').value        = f.type || 'text';
        document.getElementById('fm-key').value         = f.key || '';
        document.getElementById('fm-label').value       = f.label || '';
        document.getElementById('fm-content').value     = f.content || '';
        document.getElementById('fm-width').value       = f.width || 'full';
        document.getElementById('fm-required').checked  = !!f.required;
        document.getElementById('fm-placeholder').value = f.placeholder || '';
        document.getElementById('fm-helptext').value    = f.helpText || '';
        document.getElementById('fm-rows').value        = f.rows || 3;
        document.getElementById('fm-options').value     = (f.options || []).join('\n');
        fbUpdateModal();
    }

    function esc(s)  { return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
    function escH(s) { return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function escA(s) { return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;'); }

    function parseLinks(raw) {
        const re = /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g;
        const parts = [];
        let last = 0, m;
        while ((m = re.exec(raw)) !== null) {
            parts.push(escH(raw.slice(last, m.index)));
            parts.push(`<a href="${escA(m[2])}" target="_blank" rel="noopener noreferrer">${escH(m[1])}</a>`);
            last = m.index + m[0].length;
        }
        parts.push(escH(raw.slice(last)));
        return parts.join('');
    }

    window.fbInsertLink = function () {
        const ta    = document.getElementById('fm-content');
        const start = ta.selectionStart, end = ta.selectionEnd;
        const sel   = ta.value.substring(start, end);
        const text  = prompt('Link text:', sel || '');
        if (text === null) return;
        const url = prompt('URL (https://...):');
        if (!url) return;
        if (!/^https?:\/\//i.test(url)) { alert('URL must start with http:// or https://'); return; }
        const insert = `[${text || url}](${url})`;
        ta.value = ta.value.substring(0, start) + insert + ta.value.substring(end);
        ta.setSelectionRange(start + insert.length, start + insert.length);
        ta.focus();
    };

    // ── PDF Style tab ─────────────────────────────────────────────────────
    function loadPdfStyleUI() {
        const s = schema.pdfStyle || {};
        document.getElementById('fb-pdf-color').value        = s.accentColor || '#285190';
        document.getElementById('fb-pdf-fieldstyle').value   = s.fieldStyle  || 'underline';
        document.getElementById('fb-pdf-fontsize').value     = String(s.fontSize || 9);
        document.getElementById('fb-pdf-compact').checked    = !!s.compact;
        document.getElementById('fb-pdf-showmeta').checked   = s.showMeta !== false; // default true
    }
    window.fbUpdatePdfStyle = function () {
        if (!schema.pdfStyle) schema.pdfStyle = {};
        schema.pdfStyle.accentColor = document.getElementById('fb-pdf-color').value;
        schema.pdfStyle.fieldStyle  = document.getElementById('fb-pdf-fieldstyle').value;
        schema.pdfStyle.fontSize    = parseInt(document.getElementById('fb-pdf-fontsize').value) || 9;
        schema.pdfStyle.compact     = document.getElementById('fb-pdf-compact').checked;
        schema.pdfStyle.showMeta    = document.getElementById('fb-pdf-showmeta').checked;
        saveToTA();
    };

    let _pdfObjectUrl = null;

    window.fbPreviewPdf = async function () {
        if (!PDF_PREVIEW_URL) return;
        if (document.getElementById('fb-pane-visual').style.display !== 'none') saveToTA();
        if (document.getElementById('fb-pane-pdf').style.display !== 'none') fbUpdatePdfStyle();

        // Show modal with spinner
        const loadingEl = document.getElementById('fb-pdf-loading');
        loadingEl.innerHTML = '<div class="text-center text-muted"><div class="spinner-border d-block mx-auto mb-2" style="width:2rem;height:2rem"></div><small>Generating PDF…</small></div>';
        loadingEl.style.display = 'flex';
        document.getElementById('fb-pdf-frame').src = 'about:blank';
        new bootstrap.Modal(document.getElementById('fbPdfPreviewModal')).show();

        // Revoke previous object URL to free memory
        if (_pdfObjectUrl) { URL.revokeObjectURL(_pdfObjectUrl); _pdfObjectUrl = null; }

        const fd = new FormData();
        const tok = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tok) fd.append('__RequestVerificationToken', tok.value);
        fd.append('PreviewSchemaJson', document.getElementById(TA_ID).value);
        const nameEl = document.querySelector('input[name="Input.Name"]');
        if (nameEl) fd.append('PreviewName', nameEl.value);

        try {
            const resp = await fetch(PDF_PREVIEW_URL, { method: 'POST', body: fd });
            if (!resp.ok) throw new Error('Server returned ' + resp.status);
            const blob = await resp.blob();
            _pdfObjectUrl = URL.createObjectURL(blob);
            document.getElementById('fb-pdf-frame').src = _pdfObjectUrl;
            loadingEl.style.display = 'none';
        } catch (e) {
            loadingEl.innerHTML = '<div class="text-danger small p-4 text-center"><i class="bi bi-exclamation-triangle-fill d-block fs-3 mb-2"></i>Failed to generate PDF preview.<br><small class="text-muted">' + e.message + '</small></div>';
        }
    };

    // ── Preview ────────────────────────────────────────────────────────────
    let prevSchema = null, prevPage = 0;

    window.fbOpenPreview = function () {
        // Sync visual state to textarea first
        if (document.getElementById('fb-pane-visual').style.display !== 'none') saveToTA();
        const ta = document.getElementById(TA_ID);
        try { prevSchema = JSON.parse(ta.value.trim()); }
        catch (e) { alert('Cannot preview: invalid JSON\n' + e.message); return; }
        prevPage = 0;
        renderPreview();
        new bootstrap.Modal(document.getElementById('fbPreviewModal')).show();
    };

    function renderPreview() {
        const pages = prevSchema.pages || [];
        const page  = pages[prevPage] || { title: '', fields: [] };

        // Step pills
        const stepsEl = document.getElementById('fb-prev-steps');
        stepsEl.innerHTML = pages.length > 1 ? pages.map((p, i) =>
            `<span style="font-size:.72rem;padding:2px 8px;border-radius:10px;cursor:pointer;` +
            `background:${i===prevPage?'rgba(255,255,255,.9)':'rgba(255,255,255,.2)'};` +
            `color:${i===prevPage?'#285190':'rgba(255,255,255,.85)'};font-weight:${i===prevPage?'700':'400'}" ` +
            `onclick="window._fbPrevGo(${i})">${i+1}. ${escH(p.title||'Page '+(i+1))}</span>`
        ).join('') : '';

        // Body
        let html = '';
        if (page.intro) {
            html += `<div class="alert mb-4" style="background:#e8efff;border-left:4px solid #285190;font-size:.85rem">${escH(page.intro)}</div>`;
        }
        html += '<div class="row g-3">';
        for (const f of (page.fields || [])) html += prevField(f);
        html += '</div>';
        document.getElementById('fb-prev-body').innerHTML = html;

        // Footer nav
        const footer = document.getElementById('fb-prev-footer');
        footer.innerHTML =
            `<div class="d-flex justify-content-between w-100">` +
            `<button class="btn btn-outline-secondary btn-sm" ${prevPage===0?'disabled':''} onclick="window._fbPrevGo(${prevPage-1})"><i class="bi bi-arrow-left me-1"></i>Back</button>` +
            `<span class="text-muted small align-self-center">${pages.length>1?`Page ${prevPage+1} of ${pages.length}`:''}</span>` +
            (prevPage < pages.length - 1
                ? `<button class="btn btn-mpd btn-sm" onclick="window._fbPrevGo(${prevPage+1})">Next <i class="bi bi-arrow-right ms-1"></i></button>`
                : `<button class="btn btn-success btn-sm" disabled><i class="bi bi-send me-1"></i>Submit</button>`) +
            `</div>`;
    }

    window._fbPrevGo = function (i) { prevPage = i; renderPreview(); };

    function prevField(f) {
        const wc  = ({half:'col-md-6',third:'col-md-4',quarter:'col-md-3'})[f.width] || 'col-12';
        const lbl = escH(f.label || '');
        const req = f.required ? '<span class="text-danger ms-1">*</span>' : '';
        const ht  = f.helpText ? `<div class="form-text">${escH(f.helpText)}</div>` : '';

        switch (f.type) {
            case 'section_header':
                return `<div class="col-12"><div style="border-top:2px solid #285190;margin:.5rem 0 .25rem;padding-top:.4rem;font-weight:600;color:#285190;font-size:.95rem">${lbl}</div></div>`;

            case 'paragraph':
                return `<div class="col-12"><div class="p-3 rounded" style="background:#f8f9fa;font-size:.82rem;line-height:1.7;color:#444;white-space:pre-line">${parseLinks(f.content||'')}</div></div>`;

            case 'initials_panel':
                return `<div class="col-12"><div class="p-2 rounded" style="background:#e8efff;border:1px solid #c6d4f3;font-size:.82rem;color:#285190"><i class="bi bi-keyboard me-1"></i>Initials setup — applicant types or draws their initials here</div></div>`;

            case 'initials_reminder':
                return `<div class="col-12"><div class="p-2 rounded" style="background:#fff8e1;border:1px solid #ffe082;font-size:.82rem;color:#6d5700"><i class="bi bi-bell me-1"></i>Initials reminder</div></div>`;

            case 'initials':
                return `<div class="col-12"><div class="d-flex gap-3 align-items-start py-1" style="border-bottom:1px solid #f0f0f0">` +
                    `<div style="border:1.5px solid #ced4da;border-radius:4px;width:64px;min-height:44px;background:#f8f9fa;flex-shrink:0"></div>` +
                    `<div style="font-size:.85rem;line-height:1.5">${lbl}${req}</div></div></div>`;

            case 'textarea':
                return `<div class="${wc}"><label class="form-label">${lbl}${req}</label>` +
                    `<textarea class="form-control" rows="${f.rows||3}" placeholder="${escA(f.placeholder||'')}"></textarea>${ht}</div>`;

            case 'select':
                return `<div class="${wc}"><label class="form-label">${lbl}${req}</label>` +
                    `<select class="form-select"><option>-- Select --</option>` +
                    (f.options||[]).map(o=>`<option>${escH(o)}</option>`).join('') +
                    `</select>${ht}</div>`;

            case 'radio': {
                const opts = (f.options||[]).map(o =>
                    `<div class="form-check"><input type="radio" class="form-check-input" name="prev_${escA(f.key||'')}">` +
                    `<label class="form-check-label">${escH(o)}</label></div>`).join('');
                return `<div class="${wc}"><label class="form-label">${lbl}${req}</label>` +
                    `<div class="d-flex flex-wrap gap-3 mt-1">${opts}</div>${ht}</div>`;
            }

            case 'yesno':
                return `<div class="${wc}"><label class="form-label">${lbl}${req}</label>` +
                    `<div class="d-flex gap-3 mt-1">` +
                    `<div class="form-check"><input type="radio" class="form-check-input" name="prev_${escA(f.key||'')}"><label class="form-check-label">Yes</label></div>` +
                    `<div class="form-check"><input type="radio" class="form-check-input" name="prev_${escA(f.key||'')}"><label class="form-check-label">No</label></div>` +
                    `</div>${ht}</div>`;

            case 'checkbox':
                return `<div class="${wc}"><div class="form-check mt-2">` +
                    `<input type="checkbox" class="form-check-input">` +
                    `<label class="form-check-label">${lbl}${req}</label></div></div>`;

            case 'signature':
                return `<div class="${wc}"><label class="form-label fw-bold">${lbl}${req}</label>` +
                    `<div style="border:1px solid #ced4da;border-radius:4px;height:120px;background:#fff;display:flex;align-items:center;justify-content:center;color:#adb5bd;cursor:crosshair">` +
                    `<i class="bi bi-pen me-1"></i>Sign here</div>` +
                    `<button type="button" class="btn btn-sm btn-outline-secondary mt-1">Clear</button></div>`;

            default: {
                const t = ['text','email','tel','date','number'].includes(f.type) ? f.type : 'text';
                return `<div class="${wc}"><label class="form-label">${lbl}${req}</label>` +
                    `<input type="${t}" class="form-control" placeholder="${escA(f.placeholder||'')}">` +
                    `${ht}</div>`;
            }
        }
    }
})();
</script>
