@model (string Json, string InputName)
@{
    var inputId = Model.InputName.Replace(".", "_");
}

<ul class="nav nav-tabs mb-0" role="tablist" id="fb-tabs">
    <li class="nav-item">
        <button type="button" class="nav-link active" id="fb-tab-visual" onclick="fbSwitchTab('visual')">
            <i class="bi bi-grid-1x2-fill me-1"></i>Visual Editor
        </button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link" id="fb-tab-json" onclick="fbSwitchTab('json')">
            <i class="bi bi-code-slash me-1"></i>JSON
        </button>
    </li>
</ul>

<!-- Visual Editor Pane -->
<div id="fb-pane-visual" class="border border-top-0 rounded-bottom p-3">
    <div id="fb-pages"></div>
    <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="fbAddPage()">
        <i class="bi bi-plus me-1"></i>Add Page
    </button>
</div>

<!-- JSON Pane -->
<div id="fb-pane-json" class="border border-top-0 rounded-bottom" style="display:none">
    <textarea name="@Model.InputName" id="@inputId"
              class="form-control font-monospace border-0 rounded-bottom"
              rows="22" style="font-size:0.78rem">@Model.Json</textarea>
</div>

<!-- Field Edit Modal -->
<div class="modal fade" id="fbFieldModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fbFieldModalTitle">Field</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-5" id="fm-row-type">
                        <label class="form-label fw-semibold">Field Type</label>
                        <select id="fm-type" class="form-select" onchange="fbUpdateModalVisibility()">
                            <optgroup label="Input Fields">
                                <option value="text">Text</option>
                                <option value="email">Email</option>
                                <option value="tel">Phone</option>
                                <option value="date">Date</option>
                                <option value="number">Number</option>
                                <option value="textarea">Textarea (multi-line)</option>
                            </optgroup>
                            <optgroup label="Choice Fields">
                                <option value="select">Dropdown (Select)</option>
                                <option value="radio">Radio Buttons</option>
                                <option value="yesno">Yes / No</option>
                                <option value="checkbox">Checkbox</option>
                            </optgroup>
                            <optgroup label="Signatures &amp; Initials">
                                <option value="signature">Signature Pad</option>
                                <option value="initials">Initials Field</option>
                                <option value="initials_panel">Initials Setup Panel</option>
                                <option value="initials_reminder">Initials Reminder</option>
                            </optgroup>
                            <optgroup label="Layout">
                                <option value="section_header">Section Header</option>
                                <option value="paragraph">Paragraph / Text Block</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="col-md-4" id="fm-row-key">
                        <label class="form-label fw-semibold">Field Key <span class="text-danger">*</span></label>
                        <input type="text" id="fm-key" class="form-control" placeholder="field_key" />
                        <div class="form-text">Unique, snake_case identifier</div>
                    </div>
                    <div class="col-md-3" id="fm-row-width">
                        <label class="form-label fw-semibold">Width</label>
                        <select id="fm-width" class="form-select">
                            <option value="full">Full width</option>
                            <option value="half">Half (50%)</option>
                            <option value="third">Third (33%)</option>
                            <option value="quarter">Quarter (25%)</option>
                        </select>
                    </div>
                    <div class="col-12" id="fm-row-label">
                        <label class="form-label fw-semibold">Label</label>
                        <input type="text" id="fm-label" class="form-control"
                               placeholder="Label shown to applicant" oninput="fbAutoKey()" />
                    </div>
                    <div class="col-12" id="fm-row-content">
                        <label class="form-label fw-semibold">Content</label>
                        <textarea id="fm-content" class="form-control" rows="5"
                                  placeholder="Paragraph text shown to applicant..."></textarea>
                    </div>
                    <div class="col-12" id="fm-row-options">
                        <label class="form-label fw-semibold">
                            Options <span class="text-muted fw-normal small">— one per line</span>
                        </label>
                        <textarea id="fm-options" class="form-control font-monospace" rows="5"
                                  placeholder="Option 1&#10;Option 2&#10;Option 3"></textarea>
                    </div>
                    <div class="col-md-6" id="fm-row-placeholder">
                        <label class="form-label">Placeholder Text</label>
                        <input type="text" id="fm-placeholder" class="form-control" />
                    </div>
                    <div class="col-md-6" id="fm-row-helptext">
                        <label class="form-label">Help Text</label>
                        <input type="text" id="fm-helptext" class="form-control" />
                    </div>
                    <div class="col-md-3" id="fm-row-rows">
                        <label class="form-label">Textarea Rows</label>
                        <input type="number" id="fm-rows" class="form-control" value="3" min="2" max="20" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end" id="fm-row-required">
                        <div class="form-check mb-2">
                            <input type="checkbox" id="fm-required" class="form-check-input" />
                            <label class="form-check-label fw-semibold" for="fm-required">Required</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="fbSaveField()">
                    <i class="bi bi-check-lg me-1"></i>Save Field
                </button>
            </div>
        </div>
    </div>
</div>

<style>
.fb-page-hdr {
    background: #285190; color: #fff; padding: .45rem .75rem;
    border-radius: 4px 4px 0 0; display: flex; align-items: center; gap: .4rem;
}
.fb-page-hdr .fb-page-title { flex-grow: 1; font-weight: 600; font-size: .9rem; }
.fb-page-body {
    border: 1px solid #dee2e6; border-top: 0;
    border-radius: 0 0 4px 4px; padding: .75rem; margin-bottom: 1rem;
}
.fb-field-row {
    display: flex; align-items: center; gap: .4rem;
    padding: .3rem .5rem; border: 1px solid #e9ecef;
    border-radius: 4px; margin-bottom: .3rem; background: #fff;
}
.fb-field-row:hover { background: #f8f9fa; }
.fb-type-badge {
    font-size: .68rem; padding: .12rem .38rem; border-radius: 3px;
    font-weight: 700; white-space: nowrap; flex-shrink: 0;
}
.fb-field-label { flex-grow: 1; font-size: .84rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fb-field-key-tag { font-size: .7rem; color: #6c757d; flex-shrink: 0; }
.fb-icon-btn {
    border: none; background: none; padding: .18rem .38rem;
    border-radius: 3px; cursor: pointer; color: #495057; line-height: 1;
}
.fb-icon-btn:hover { background: #e9ecef; }
.fb-icon-btn.danger:hover { background: #f8d7da; color: #842029; }
</style>

<script>
(function () {
    const TA_ID = '@inputId';
    let schema = { pages: [] };
    let editPage = -1;
    let editField = -1;
    let autoKeyLocked = false;

    // ── Type config ────────────────────────────────────────────────────────
    const TYPE_PROPS = {
        text:              ['key','label','width','required','placeholder','helptext'],
        email:             ['key','label','width','required','placeholder','helptext'],
        tel:               ['key','label','width','required','placeholder','helptext'],
        date:              ['key','label','width','required','helptext'],
        number:            ['key','label','width','required','placeholder','helptext'],
        textarea:          ['key','label','width','required','placeholder','helptext','rows'],
        select:            ['key','label','width','required','options'],
        radio:             ['key','label','width','required','options'],
        yesno:             ['key','label','width','required','helptext'],
        checkbox:          ['key','label','width'],
        signature:         ['key','label','width','required'],
        initials:          ['key','label','required'],
        initials_panel:    [],
        initials_reminder: [],
        section_header:    ['key','label'],
        paragraph:         ['key','content'],
    };

    const TYPE_BADGE = {
        text:              ['bg-secondary text-white','text'],
        email:             ['bg-secondary text-white','email'],
        tel:               ['bg-secondary text-white','phone'],
        date:              ['bg-secondary text-white','date'],
        number:            ['bg-secondary text-white','number'],
        textarea:          ['bg-secondary text-white','textarea'],
        select:            ['bg-primary text-white','select'],
        radio:             ['bg-primary text-white','radio'],
        yesno:             ['bg-primary text-white','yes/no'],
        checkbox:          ['bg-primary text-white','checkbox'],
        signature:         ['bg-danger text-white','signature'],
        initials:          ['bg-warning text-dark','initials'],
        initials_panel:    ['bg-info text-dark','init-panel'],
        initials_reminder: ['bg-info text-dark','init-remind'],
        section_header:    ['bg-dark text-white','header'],
        paragraph:         ['bg-light text-dark border','paragraph'],
    };

    // ── Init ───────────────────────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        loadFromTextarea();
        renderVisual();

        const ta = document.getElementById(TA_ID);
        if (ta) {
            const form = ta.closest('form');
            if (form) form.addEventListener('submit', () => {
                if (document.getElementById('fb-pane-visual').style.display !== 'none') {
                    saveToTextarea();
                }
            });
        }

        document.getElementById('fm-key').addEventListener('input', function () {
            autoKeyLocked = !!this.value;
        });
    });

    // ── State helpers ──────────────────────────────────────────────────────
    function loadFromTextarea() {
        const ta = document.getElementById(TA_ID);
        const val = ta ? ta.value.trim() : '';
        try {
            const parsed = val ? JSON.parse(val) : null;
            schema = (parsed && Array.isArray(parsed.pages)) ? parsed : { pages: [] };
            if (!schema.pages.length) schema.pages.push({ title: 'Page 1', fields: [] });
        } catch (e) {
            schema = { pages: [{ title: 'Page 1', fields: [] }] };
        }
    }

    function saveToTextarea() {
        const ta = document.getElementById(TA_ID);
        if (ta) ta.value = JSON.stringify(schema, null, 2);
    }

    // ── Tab switching ──────────────────────────────────────────────────────
    window.fbSwitchTab = function (tab) {
        const toVisual = tab === 'visual';
        if (toVisual) {
            const ta = document.getElementById(TA_ID);
            const val = ta ? ta.value.trim() : '';
            try {
                const parsed = val ? JSON.parse(val) : null;
                if (parsed && Array.isArray(parsed.pages)) {
                    schema = parsed;
                } else if (val) {
                    alert('JSON is invalid — fix it before switching to Visual Editor.');
                    return;
                }
            } catch (e) {
                alert('JSON is invalid — fix it before switching to Visual Editor.\n\n' + e.message);
                return;
            }
            renderVisual();
        } else {
            saveToTextarea();
        }
        document.getElementById('fb-pane-visual').style.display = toVisual ? '' : 'none';
        document.getElementById('fb-pane-json').style.display = toVisual ? 'none' : '';
        document.getElementById('fb-tab-visual').classList.toggle('active', toVisual);
        document.getElementById('fb-tab-json').classList.toggle('active', !toVisual);
    };

    // ── Render ─────────────────────────────────────────────────────────────
    function renderVisual() {
        const container = document.getElementById('fb-pages');
        container.innerHTML = '';
        schema.pages.forEach((page, pi) => container.appendChild(buildPageEl(page, pi)));
    }

    function buildPageEl(page, pi) {
        const wrap = document.createElement('div');

        const hdr = document.createElement('div');
        hdr.className = 'fb-page-hdr';
        hdr.innerHTML =
            `<span class="fb-page-title">Page ${pi + 1}</span>` +
            `<button type="button" class="fb-icon-btn" title="Move up" onclick="fbMovePage(${pi},-1)"><i class="bi bi-chevron-up"></i></button>` +
            `<button type="button" class="fb-icon-btn" title="Move down" onclick="fbMovePage(${pi},1)"><i class="bi bi-chevron-down"></i></button>` +
            `<button type="button" class="fb-icon-btn danger" title="Delete page" onclick="fbDeletePage(${pi})"><i class="bi bi-x-lg"></i></button>`;
        wrap.appendChild(hdr);

        const body = document.createElement('div');
        body.className = 'fb-page-body';
        body.innerHTML =
            `<div class="row g-2 mb-3">` +
            `<div class="col-md-4"><label class="form-label small fw-semibold mb-1">Page Title</label>` +
            `<input type="text" class="form-control form-control-sm" value="${esc(page.title || '')}" onchange="fbUpdatePage(${pi},'title',this.value)" /></div>` +
            `<div class="col-md-8"><label class="form-label small fw-semibold mb-1">Intro Text <span class="text-muted fw-normal">(optional)</span></label>` +
            `<input type="text" class="form-control form-control-sm" value="${esc(page.intro || '')}" onchange="fbUpdatePage(${pi},'intro',this.value)" /></div>` +
            `</div>` +
            `<div id="fb-fields-${pi}">${buildFieldsHtml(page.fields || [], pi)}</div>` +
            `<button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="fbAddField(${pi})">` +
            `<i class="bi bi-plus me-1"></i>Add Field</button>`;
        wrap.appendChild(body);
        return wrap;
    }

    function buildFieldsHtml(fields, pi) {
        if (!fields.length) {
            return '<div class="text-muted small py-2 text-center">No fields yet — click Add Field below.</div>';
        }
        return fields.map((f, fi) => buildFieldRowHtml(f, pi, fi)).join('');
    }

    function buildFieldRowHtml(f, pi, fi) {
        const b = TYPE_BADGE[f.type] || ['bg-light border', f.type];
        const label = f.type === 'paragraph' ? '(paragraph block)' :
            f.type === 'initials_panel' ? '(initials setup panel)' :
            f.type === 'initials_reminder' ? '(initials reminder)' :
            escHtml(f.label || f.key || '');
        const keyTag = f.key && f.type !== 'initials_panel' && f.type !== 'initials_reminder'
            ? `<span class="fb-field-key-tag">[${escHtml(f.key)}]</span>` : '';
        const req = f.required ? '<span class="text-danger ms-1" title="Required">*</span>' : '';
        return `<div class="fb-field-row">` +
            `<span class="fb-type-badge ${b[0]}">${b[1]}</span>` +
            `<span class="fb-field-label">${label}${req}</span>` +
            `${keyTag}` +
            `<button type="button" class="fb-icon-btn" title="Edit field" onclick="fbOpenFieldModal(${pi},${fi})"><i class="bi bi-pencil-fill"></i></button>` +
            `<button type="button" class="fb-icon-btn" title="Move up" onclick="fbMoveField(${pi},${fi},-1)"><i class="bi bi-chevron-up"></i></button>` +
            `<button type="button" class="fb-icon-btn" title="Move down" onclick="fbMoveField(${pi},${fi},1)"><i class="bi bi-chevron-down"></i></button>` +
            `<button type="button" class="fb-icon-btn danger" title="Delete field" onclick="fbDeleteField(${pi},${fi})"><i class="bi bi-trash"></i></button>` +
            `</div>`;
    }

    // ── Page actions ───────────────────────────────────────────────────────
    window.fbAddPage = function () {
        schema.pages.push({ title: `Page ${schema.pages.length + 1}`, fields: [] });
        renderVisual(); saveToTextarea();
    };

    window.fbDeletePage = function (pi) {
        if (schema.pages.length <= 1) { alert('A form must have at least one page.'); return; }
        if (!confirm(`Delete Page ${pi + 1} and all its fields?`)) return;
        schema.pages.splice(pi, 1);
        renderVisual(); saveToTextarea();
    };

    window.fbMovePage = function (pi, dir) {
        const to = pi + dir;
        if (to < 0 || to >= schema.pages.length) return;
        [schema.pages[pi], schema.pages[to]] = [schema.pages[to], schema.pages[pi]];
        renderVisual(); saveToTextarea();
    };

    window.fbUpdatePage = function (pi, prop, val) {
        schema.pages[pi][prop] = val;
        saveToTextarea();
    };

    // ── Field actions ──────────────────────────────────────────────────────
    window.fbAddField = function (pi) {
        editPage = pi; editField = -1; autoKeyLocked = false;
        resetModal();
        document.getElementById('fbFieldModalTitle').textContent = 'Add Field';
        new bootstrap.Modal(document.getElementById('fbFieldModal')).show();
    };

    window.fbOpenFieldModal = function (pi, fi) {
        editPage = pi; editField = fi; autoKeyLocked = true;
        populateModal(schema.pages[pi].fields[fi]);
        document.getElementById('fbFieldModalTitle').textContent = 'Edit Field';
        new bootstrap.Modal(document.getElementById('fbFieldModal')).show();
    };

    window.fbMoveField = function (pi, fi, dir) {
        const fields = schema.pages[pi].fields;
        const to = fi + dir;
        if (to < 0 || to >= fields.length) return;
        [fields[fi], fields[to]] = [fields[to], fields[fi]];
        document.getElementById(`fb-fields-${pi}`).innerHTML = buildFieldsHtml(fields, pi);
        saveToTextarea();
    };

    window.fbDeleteField = function (pi, fi) {
        schema.pages[pi].fields.splice(fi, 1);
        document.getElementById(`fb-fields-${pi}`).innerHTML = buildFieldsHtml(schema.pages[pi].fields, pi);
        saveToTextarea();
    };

    window.fbSaveField = function () {
        const type = document.getElementById('fm-type').value;
        const props = TYPE_PROPS[type] || [];
        const field = { type };

        if (props.includes('key')) {
            const key = document.getElementById('fm-key').value.trim();
            if (!key) { alert('Field Key is required.'); return; }
            field.key = key;
        } else {
            // auto-key for types with no key shown
            field.key = type + '_' + Math.random().toString(36).slice(2, 7);
        }

        if (props.includes('label')) {
            field.label = document.getElementById('fm-label').value.trim() || undefined;
        }
        if (props.includes('content')) {
            field.content = document.getElementById('fm-content').value || undefined;
        }
        if (props.includes('width')) {
            field.width = document.getElementById('fm-width').value || undefined;
        }
        if (props.includes('required') && document.getElementById('fm-required').checked) {
            field.required = true;
        }
        if (props.includes('placeholder')) {
            const ph = document.getElementById('fm-placeholder').value.trim();
            if (ph) field.placeholder = ph;
        }
        if (props.includes('helptext')) {
            const ht = document.getElementById('fm-helptext').value.trim();
            if (ht) field.helpText = ht;
        }
        if (props.includes('rows')) {
            field.rows = parseInt(document.getElementById('fm-rows').value) || 3;
        }
        if (props.includes('options')) {
            field.options = document.getElementById('fm-options').value
                .split('\n').map(s => s.trim()).filter(Boolean);
        }

        // Clean up undefined values
        Object.keys(field).forEach(k => field[k] === undefined && delete field[k]);

        const fields = schema.pages[editPage].fields;
        if (editField >= 0) fields[editField] = field; else fields.push(field);

        document.getElementById(`fb-fields-${editPage}`).innerHTML = buildFieldsHtml(fields, editPage);
        saveToTextarea();
        bootstrap.Modal.getInstance(document.getElementById('fbFieldModal')).hide();
    };

    // ── Modal helpers ──────────────────────────────────────────────────────
    window.fbUpdateModalVisibility = function () {
        const type = document.getElementById('fm-type').value;
        const props = TYPE_PROPS[type] || [];
        const rows = ['key', 'label', 'content', 'width', 'required',
                      'placeholder', 'helptext', 'rows', 'options'];
        rows.forEach(r => {
            const el = document.getElementById(`fm-row-${r}`);
            if (el) el.style.display = props.includes(r) ? '' : 'none';
        });
    };

    window.fbAutoKey = function () {
        if (autoKeyLocked) return;
        const type = document.getElementById('fm-type').value;
        const props = TYPE_PROPS[type] || [];
        if (!props.includes('key')) return;
        const prefix = type === 'section_header' ? 'sec_' : '';
        const raw = document.getElementById('fm-label').value;
        document.getElementById('fm-key').value = prefix + raw.toLowerCase()
            .replace(/[^a-z0-9\s]/g, '').trim().replace(/\s+/g, '_').substring(0, 40);
    };

    function resetModal() {
        document.getElementById('fm-type').value = 'text';
        document.getElementById('fm-key').value = '';
        document.getElementById('fm-label').value = '';
        document.getElementById('fm-content').value = '';
        document.getElementById('fm-width').value = 'full';
        document.getElementById('fm-required').checked = false;
        document.getElementById('fm-placeholder').value = '';
        document.getElementById('fm-helptext').value = '';
        document.getElementById('fm-rows').value = '3';
        document.getElementById('fm-options').value = '';
        fbUpdateModalVisibility();
    }

    function populateModal(f) {
        document.getElementById('fm-type').value = f.type || 'text';
        document.getElementById('fm-key').value = f.key || '';
        document.getElementById('fm-label').value = f.label || '';
        document.getElementById('fm-content').value = f.content || '';
        document.getElementById('fm-width').value = f.width || 'full';
        document.getElementById('fm-required').checked = !!f.required;
        document.getElementById('fm-placeholder').value = f.placeholder || '';
        document.getElementById('fm-helptext').value = f.helpText || '';
        document.getElementById('fm-rows').value = f.rows || 3;
        document.getElementById('fm-options').value = (f.options || []).join('\n');
        fbUpdateModalVisibility();
    }

    // ── Utils ──────────────────────────────────────────────────────────────
    function esc(s) {
        return (s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function escHtml(s) {
        return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
})();
</script>
