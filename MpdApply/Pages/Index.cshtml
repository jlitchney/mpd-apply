@page
@model IndexModel
@{
    ViewData["Title"] = "Online Forms";
}

<div class="text-center pt-4 pb-3">
    @if (!string.IsNullOrEmpty(Model.LogoBase64))
    {
        <img src="@Model.LogoBase64" style="max-height:90px;max-width:180px;object-fit:contain" />
    }
    else
    {
        <i class="bi bi-shield-fill" style="font-size:3rem;color:#285190"></i>
    }
    <h2 class="mt-2 mb-1">Available Forms</h2>
    <p class="text-muted mb-4" style="max-width:520px;margin:auto">
        Select a form below to get started. Your progress is saved at each step.
    </p>
</div>

@if (!Model.PublishedForms.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
        No forms are currently available. Please check back later.
    </div>
}
else
{
    <div class="row g-3 justify-content-center">
        @foreach (var form in Model.PublishedForms)
        {
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header-mpd">
                        <i class="bi bi-file-earmark-text me-2"></i>@form.Name
                    </div>
                    <div class="card-body d-flex flex-column">
                        @if (!string.IsNullOrWhiteSpace(form.Description))
                        {
                            <p class="text-muted small flex-grow-1">@form.Description</p>
                        }
                        else
                        {
                            <div class="flex-grow-1"></div>
                        }
                        <a asp-page="/Forms/View" asp-route-slug="@form.Slug" class="btn btn-mpd mt-3">
                            <i class="bi bi-pencil-fill me-1"></i>Start Form
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
