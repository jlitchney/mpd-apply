@page
@model IndexModel
@{
    ViewData["Title"] = "Employment Application";
}

<div class="text-center py-5">
    <i class="bi bi-shield-fill text-primary" style="font-size:3.5rem;color:#285190!important"></i>
    <h2 class="mt-3">Town of Middletown Police Department</h2>
    <h4 class="text-muted mb-4">Employment Application</h4>
    <p class="mb-4 text-muted" style="max-width:560px;margin:auto">
        Complete this online application for employment with the Middletown Police Department.
        The application takes approximately 15–20 minutes. Your progress is saved at each step.
    </p>
    <a asp-page="/Apply/Step1" class="btn btn-mpd btn-lg px-5">
        <i class="bi bi-pencil-fill me-2"></i>Start Application
    </a>
    <div class="mt-4 text-muted small">
        <i class="bi bi-info-circle me-1"></i>
        You will need your Social Security Number, Driver's License, and employment history.
    </div>
</div>
