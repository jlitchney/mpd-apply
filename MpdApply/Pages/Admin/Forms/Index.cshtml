@page
@model MpdApply.Pages.Admin.Forms.FormsIndexModel
@{ ViewData["Title"] = "Manage Forms"; ViewData["IsAdmin"] = true; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Forms</h4>
    <a asp-page="/Admin/Forms/Create" class="btn btn-sm btn-mpd">
        <i class="bi bi-plus-lg me-1"></i>New Form
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (!Model.Templates.Any())
{
    <div class="card shadow-sm"><div class="card-body text-center text-muted py-5">No forms yet. Create one above.</div></div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background:#f8f9fa">
                    <tr><th>Name</th><th>Slug / URL</th><th>Status</th><th>Submissions</th><th>Created</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Templates)
                    {
                        <tr>
                            <td class="fw-semibold">@t.Template.Name</td>
                            <td class="text-muted small">
                            <a href="/Forms/@t.Template.Slug" target="_blank">/Forms/@t.Template.Slug</a>
                            <button class="btn btn-link btn-sm p-0 ms-2 text-muted"
                                    onclick="copyLink('/Forms/@t.Template.Slug', this)" title="Copy link">
                                <i class="bi bi-link-45deg"></i>
                            </button>
                        </td>
                            <td>
                                @if (t.Template.IsPublished)
                                { <span class="badge bg-success">Published</span> }
                                else
                                { <span class="badge bg-secondary">Draft</span> }
                            </td>
                            <td>@t.SubmissionCount</td>
                            <td class="text-muted small">@t.Template.CreatedAt.ToLocalTime().ToString("M/d/yyyy")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-page="/Admin/Forms/FormSubmissions" asp-route-id="@t.Template.Id"
                                       class="btn btn-sm btn-outline-primary">Submissions</a>
                                    <a asp-page="/Admin/Forms/Edit" asp-route-id="@t.Template.Id"
                                       class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@t.Template.Id">
                                        <button class="btn btn-sm @(t.Template.IsPublished ? "btn-outline-warning" : "btn-outline-success")">
                                            @(t.Template.IsPublished ? "Unpublish" : "Publish")
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Duplicate" asp-route-id="@t.Template.Id">
                                        <button class="btn btn-sm btn-outline-secondary" title="Duplicate form">
                                            <i class="bi bi-copy"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@t.Template.Id"
                                          onsubmit="return confirm('Delete this form and all its submissions?')">
                                        <button class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
function copyLink(path, btn) {
    navigator.clipboard.writeText(window.location.origin + path).then(function() {
        var icon = btn.querySelector('i');
        icon.className = 'bi bi-check text-success';
        setTimeout(function() { icon.className = 'bi bi-link-45deg'; }, 2000);
    });
}
</script>
}
