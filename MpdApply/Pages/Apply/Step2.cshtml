@page
@model MpdApply.Pages.Apply.Step2Model
@{ ViewData["Title"] = "Step 2 — Employment & Experience"; ViewData["Step"] = 2; }

<div class="card shadow-sm">
    <div class="card-header-mpd">Step 2 of 5 &mdash; Employment &amp; Experience</div>
    <div class="card-body">
        <form method="post">

            <div class="section-divider">Current Employment</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Are you currently employed?</label>
                    <div class="d-flex gap-3 mt-1">
                        <div class="form-check"><input class="form-check-input" type="radio" asp-for="EmployedNow" value="True" id="empYes" /><label class="form-check-label" for="empYes">Yes</label></div>
                        <div class="form-check"><input class="form-check-input" type="radio" asp-for="EmployedNow" value="False" id="empNo" /><label class="form-check-label" for="empNo">No</label></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">May we contact your employer?</label>
                    <div class="d-flex gap-3 mt-1">
                        <div class="form-check"><input class="form-check-input" type="radio" asp-for="MayContactEmployer" value="True" id="contYes" /><label class="form-check-label" for="contYes">Yes</label></div>
                        <div class="form-check"><input class="form-check-input" type="radio" asp-for="MayContactEmployer" value="False" id="contNo" /><label class="form-check-label" for="contNo">No</label></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Current Employer</label>
                    <input asp-for="CurrentEmployer" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Position</label>
                    <input asp-for="CurrentPosition" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Date Available for Work</label>
                    <input asp-for="AvailableDate" class="form-control" type="date" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Have you previously applied to Middletown PD?</label>
                    <div class="d-flex gap-3 mt-1">
                        <div class="form-check"><input class="form-check-input" type="radio" asp-for="PreviouslyApplied" value="False" id="prevNo" /><label class="form-check-label" for="prevNo">No</label></div>
                        <div class="form-check"><input class="form-check-input" type="radio" asp-for="PreviouslyApplied" value="True" id="prevYes" /><label class="form-check-label" for="prevYes">Yes</label></div>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">If yes, when and what position?</label>
                    <input asp-for="PreviousApplicationDetails" class="form-control" />
                </div>
            </div>

            <div class="section-divider">Police Experience</div>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Police Experience</label>
                    <div class="d-flex flex-wrap gap-3 mt-1">
                        @foreach (var opt in new[] { "None", "Full-time", "Part-time", "Seasonal", "Military Police" })
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="PoliceExperience" value="@opt" id="pe_@opt.Replace(" ","_")" />
                                <label class="form-check-label" for="pe_@opt.Replace(" ","_")">@opt</label>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Department</label>
                    <input asp-for="PoliceDepartment" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Length of Employment</label>
                    <input asp-for="PoliceLength" class="form-control" placeholder="e.g. 3 years" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Position / Rank</label>
                    <input asp-for="PoliceRank" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Reason for Leaving</label>
                    <input asp-for="PoliceReasonLeaving" class="form-control" />
                </div>
            </div>

            <div class="section-divider">Armed Forces</div>
            <div class="row g-3">
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-4">
                        <div class="form-check"><input class="form-check-input" asp-for="ArmedForces" id="af" /><label class="form-check-label" for="af">Armed Forces</label></div>
                        <div class="form-check"><input class="form-check-input" asp-for="ActiveDuty" id="ad" /><label class="form-check-label" for="ad">Active Duty</label></div>
                        <div class="form-check"><input class="form-check-input" asp-for="Reserve" id="res" /><label class="form-check-label" for="res">Reserve</label></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Length of Service</label>
                    <input asp-for="ArmedForcesLength" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Branch</label>
                    <input asp-for="ArmedForcesBranch" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Honorable Discharge</label>
                    <select asp-for="HonorableDischarge" class="form-select">
                        <option value="">N/A</option>
                        <option value="Yes">Yes</option>
                        <option value="No">No</option>
                    </select>
                </div>
            </div>

            <div class="section-divider">Professional Qualifications</div>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">List any Professional Licenses, Certifications, and/or Skills</label>
                    <textarea asp-for="Licenses" class="form-control" rows="3"></textarea>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-page="Step1" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
                <button type="submit" class="btn btn-mpd px-4">Next: Eligibility <i class="bi bi-arrow-right ms-1"></i></button>
            </div>
        </form>
    </div>
</div>
