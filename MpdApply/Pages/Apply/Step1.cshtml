@page
@model MpdApply.Pages.Apply.Step1Model
@{ ViewData["Title"] = "Step 1 — Personal Information"; ViewData["Step"] = 1; }

<div class="alert mb-3" style="background:#e8efff;border-left:4px solid #285190;font-size:0.85rem">
    Applicants for all positions are considered without regard to race, color, religion, sex, national origin, age, marital status, or the presence of disabilities. <strong>The Town of Middletown is an Equal Opportunity / Affirmative Action Employer.</strong>
</div>

<div class="card shadow-sm">
    <div class="card-header-mpd">Step 1 of 5 &mdash; Personal Information</div>
    <div class="card-body">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Position Applied For <span class="text-danger">*</span></label>
                    <input asp-for="Input.PositionAppliedFor" class="form-control" placeholder="e.g. Police Officer" />
                    <span asp-validation-for="Input.PositionAppliedFor" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">How Did You Hear About Us? <span class="text-danger">*</span></label>
                    <select asp-for="Input.HowDidYouHear" class="form-select">
                        <option value="">-- Select --</option>
                        <option>Town / MPD Website</option>
                        <option>College/University</option>
                        <option>Newspaper/Publication</option>
                        <option>Job Fair / Recruitment Fair</option>
                        <option>Online Search Engine</option>
                        <option>Employee of Town/MPD</option>
                        <option>Other</option>
                    </select>
                    <span asp-validation-for="Input.HowDidYouHear" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label">Please Specify (if applicable)</label>
                    <input asp-for="Input.HowDidYouHearDetail" class="form-control" />
                </div>
            </div>

            <div class="section-divider">Name</div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Last Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.LastName" class="form-control" />
                    <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">First Name <span class="text-danger">*</span></label>
                    <input asp-for="Input.FirstName" class="form-control" />
                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                </div>
                <div class="col-md-1">
                    <label class="form-label">MI</label>
                    <input asp-for="Input.MiddleInitial" class="form-control" maxlength="1" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Nickname</label>
                    <input asp-for="Input.Nickname" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Maiden Name</label>
                    <input asp-for="Input.MaidenName" class="form-control" />
                </div>
            </div>

            <div class="section-divider">Residence Address</div>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">Street Address <span class="text-danger">*</span></label>
                    <input asp-for="Input.StreetAddress" class="form-control" />
                    <span asp-validation-for="Input.StreetAddress" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">City <span class="text-danger">*</span></label>
                    <input asp-for="Input.City" class="form-control" />
                    <span asp-validation-for="Input.City" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label class="form-label">State <span class="text-danger">*</span></label>
                    <input asp-for="Input.State" class="form-control" maxlength="2" placeholder="DE" />
                    <span asp-validation-for="Input.State" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Zip <span class="text-danger">*</span></label>
                    <input asp-for="Input.Zip" class="form-control" />
                    <span asp-validation-for="Input.Zip" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">County (if in DE)</label>
                    <input asp-for="Input.County" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Input.MailingDifferent" class="form-check-input" id="mailingDiff" />
                        <label class="form-check-label" for="mailingDiff">Mailing address is different from residence</label>
                    </div>
                </div>
                <div id="mailingSection" class="col-12 d-none">
                    <div class="row g-2">
                        <div class="col-12"><input asp-for="Input.MailingStreet" class="form-control" placeholder="Mailing Street" /></div>
                        <div class="col-md-4"><input asp-for="Input.MailingCity" class="form-control" placeholder="City" /></div>
                        <div class="col-md-2"><input asp-for="Input.MailingState" class="form-control" placeholder="State" maxlength="2" /></div>
                        <div class="col-md-2"><input asp-for="Input.MailingZip" class="form-control" placeholder="Zip" /></div>
                    </div>
                </div>
            </div>

            <div class="section-divider">Personal Details</div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Date of Birth <span class="text-danger">*</span></label>
                    <input asp-for="Input.DateOfBirth" class="form-control" type="date" />
                    <span asp-validation-for="Input.DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Social Security Number <span class="text-danger">*</span></label>
                    <input asp-for="Input.SSN" class="form-control" placeholder="XXX-XX-XXXX" />
                    <span asp-validation-for="Input.SSN" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label class="form-label">DL State</label>
                    <input asp-for="Input.DlState" class="form-control" maxlength="2" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">DL Number</label>
                    <input asp-for="Input.DlNumber" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Home Phone</label>
                    <input asp-for="Input.HomePhone" class="form-control" type="tel" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Work Phone</label>
                    <input asp-for="Input.WorkPhone" class="form-control" type="tel" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Cell Phone</label>
                    <input asp-for="Input.CellPhone" class="form-control" type="tel" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="Input.Email" class="form-control" type="email" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-mpd px-4">Next: Employment <i class="bi bi-arrow-right ms-1"></i></button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const cb = document.getElementById('mailingDiff');
    const sec = document.getElementById('mailingSection');
    cb.addEventListener('change', () => sec.classList.toggle('d-none', !cb.checked));
    if (cb.checked) sec.classList.remove('d-none');
</script>
}
