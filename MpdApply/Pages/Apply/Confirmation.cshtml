@page
@model MpdApply.Pages.Apply.ConfirmationModel
@{ ViewData["Title"] = "Application Submitted"; }

<div class="text-center py-5">
    <i class="bi bi-check-circle-fill text-success" style="font-size:4rem"></i>
    <h2 class="mt-3">Application Submitted!</h2>
    <p class="text-muted">Thank you, <strong>@Request.Query["name"]</strong>. Your employment application has been successfully submitted to the Town of Middletown Police Department.</p>
    <p class="text-muted small">A copy of your completed application has been sent to the department. You will be contacted if you are selected to continue in the hiring process.</p>
    <hr class="my-4" style="max-width:400px;margin:auto" />
    <p class="text-muted small">
        Town of Middletown Police Department<br/>
        130 Hampden Road, Middletown, DE 19709<br/>
        (302) 376-9950
    </p>
</div>
