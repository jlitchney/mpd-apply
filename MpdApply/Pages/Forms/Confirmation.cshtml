@page
@{ ViewData["Title"] = "Thank You"; }

<div class="card shadow-sm text-center py-5">
    <div class="card-body">
        <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
        <h3 class="mt-3">Submission Received!</h3>
        <p class="text-muted">
            Thank you, <strong>@Request.Query["name"]</strong>. Your
            <strong>@Request.Query["form"]</strong> has been submitted successfully.
        </p>
        <p class="text-muted small">You will be contacted if any additional information is needed.</p>
        <a href="/" class="btn btn-mpd mt-2">Return to Home</a>
    </div>
</div>
