@page
@model MpdApply.Pages.Forms.ConfirmationModel
@{ ViewData["Title"] = "Thank You"; }

@{
    var name = Request.Query["name"].ToString();
    var form = Request.Query["form"].ToString();
}

@if (Model.LogoBase64 != null || Model.AgencyName != null)
{
    <div class="mb-4 pb-3 d-flex align-items-center gap-3" style="border-bottom:3px solid #285190">
        @if (Model.LogoBase64 != null)
        {
            <img src="@Model.LogoBase64" style="max-height:64px;max-width:140px;object-fit:contain;flex-shrink:0" />
        }
        @if (Model.AgencyName != null)
        {
            <div class="fw-bold fs-5" style="color:#285190">@Model.AgencyName</div>
        }
    </div>
}

<div class="card shadow-sm text-center py-5">
    <div class="card-body">
        <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
        <h3 class="mt-3">Submission Received!</h3>
        <p class="text-muted">
            Thank you, <strong>@name</strong>. Your
            <strong>@form</strong> has been submitted successfully.
        </p>
        <p class="text-muted small">A confirmation copy has been sent to your email. You will be contacted if any additional information is needed.</p>
        <a href="/" class="btn btn-mpd mt-2">Return to Home</a>
    </div>
</div>
