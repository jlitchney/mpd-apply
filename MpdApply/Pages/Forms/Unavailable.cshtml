@page
@model MpdApply.Pages.Forms.UnavailableModel
@{ ViewData["Title"] = "Form Unavailable"; }

@if (Model.LogoBase64 != null || Model.AgencyName != null)
{
    <div class="mb-4 pb-3 d-flex align-items-center gap-3" style="border-bottom:3px solid #285190">
        @if (Model.LogoBase64 != null)
        {
            <img src="@Model.LogoBase64" style="max-height:64px;max-width:140px;object-fit:contain;flex-shrink:0" />
        }
        @if (Model.AgencyName != null)
        {
            <div class="fw-bold fs-5" style="color:#285190">@Model.AgencyName</div>
        }
    </div>
}

<div class="card shadow-sm text-center py-5">
    <div class="card-body">
        <i class="bi bi-file-earmark-x" style="font-size:3rem;color:#adb5bd"></i>
        <h3 class="mt-3">Form Not Available</h3>
        <p class="text-muted">This form is not currently available. It may have been removed or is not yet open for submissions.</p>
        <p class="text-muted small">If you believe this is an error, please contact us directly.</p>
        <a href="/" class="btn btn-mpd mt-2">Return to Home</a>
    </div>
</div>
